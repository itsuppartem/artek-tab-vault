{
  "name": "artek-tab-vault",
  "version": "0.3.2",
  "description": "Crash-proof tab session backup and idle tab memory guardian for Firefox.",
  "private": true,
  "scripts": {
    "test": "jest",
    "test:watch": "jest --watch",
    "test:firefox": "node tests/e2e/firefox.e2e.js",
    "lint": "web-ext lint --source-dir=.",
    "start": "mkdir -p \"$HOME/firefox-webext-tmp\" && TMPDIR=\"$HOME/firefox-webext-tmp\" web-ext run --source-dir=.",
    "build": "web-ext build --source-dir=. --overwrite-dest",
    "screenshots": "node scripts/make-store-assets.js",
    "sign": "web-ext sign --source-dir=. --channel=unlisted",
    "sign:listed": "web-ext sign --source-dir=. --channel=listed --amo-metadata=amo-metadata.json --approval-timeout=0"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "puppeteer-core": "^24.43.1",
    "selenium-webdriver": "^4.46.0",
    "web-ext": "^8.3.0"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "<rootDir>/tests/**/*.test.js"
    ]
  }
}
