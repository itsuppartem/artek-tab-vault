{
  "manifest_version": 2,
  "name": "Artek Tab Vault",
  "version": "0.2.0",
  "description": "Crash-proof tab session backup and idle tab memory guardian for Firefox.",
  "browser_specific_settings": {
    "gecko": {
      "id": "artek-tab-vault@artek.local",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },
  "permissions": [
    "tabs",
    "storage",
    "alarms",
    "idle",
    "notifications",
    "tabGroups",
    "unlimitedStorage",
    "<all_urls>"
  ],
  "icons": {
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png",
    "128": "icons/icon-128.png"
  },
  "background": {
    "scripts": ["core.js", "background.js"],
    "persistent": true
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content-scripts/dirty-form.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "options_ui": {
    "page": "options/options.html",
    "open_in_tabs": true
  },
  "browser_action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "48": "icons/icon-48.png",
      "96": "icons/icon-96.png"
    },
    "default_title": "Artek Tab Vault"
  },
  "commands": {
    "discard-all-except-current": {
      "suggested_key": {
        "default": "Ctrl+Shift+D"
      },
      "description": "Discard all tabs except current"
    }
  }
}
