  "help_whitelist": {
    "message": "Поддомены учитываются автоматически: example.com закроет и www.example.com."
  },
  "help_discard_shortcut": {
    "message": "Сочетание клавиш «выгрузить все, кроме текущей»: Alt+Shift+D. Можно сменить в about:addons."
